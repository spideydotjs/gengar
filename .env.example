# ── Gengar Docker & Environment Configuration ──────────────────────────────
# Application web port
PORT=6700

# Application host binding
HOST=0.0.0.0

# SOCKS5 proxy URL used by Gengar container
TOR_SOCKS=socks5h://tor:9050

# Host port mapped to the containerized Tor SOCKS5 proxy
# Default is 9052 to avoid conflicting if Tor is already running on host port 9050.
# If host Tor is not installed, you can set this to 9050.
TOR_HOST_PORT=9052
